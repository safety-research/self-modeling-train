# API Keys - Copy this file to .env and fill in your keys
# cp .env.example .env
# Only set keys for the providers you actually use; others are skipped.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional providers — uncomment to enable
# GOOGLE_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=

# Hugging Face (for dataset downloads)
HF_TOKEN=hf_...

# Tinker (for GRPO training — https://thinkingmachines.ai/tinker)
TINKER_API_KEY=tml-...
